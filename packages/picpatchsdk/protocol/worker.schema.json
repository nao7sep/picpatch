{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkerMessage",
  "oneOf": [
    {
      "$ref": "#/definitions/Request"
    },
    {
      "$ref": "#/definitions/Response"
    }
  ],
  "definitions": {
    "Hello": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "hello"
        },
        "model": {
          "$ref": "contracts.schema.json#/definitions/LocalEditingModel"
        },
        "runtimeCheck": {
          "enum": [
            "imports",
            "load"
          ]
        }
      },
      "required": [
        "version",
        "id",
        "type"
      ],
      "additionalProperties": false,
      "dependencies": {
        "runtimeCheck": [
          "model"
        ]
      }
    },
    "Edit": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "edit"
        },
        "request": {
          "$ref": "contracts.schema.json#/definitions/EditRequest"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "request"
      ],
      "additionalProperties": false
    },
    "Cancel": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "cancel"
        },
        "targetId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "targetId"
      ],
      "additionalProperties": false
    },
    "Shutdown": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "shutdown"
        }
      },
      "required": [
        "version",
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "Ready": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "ready"
        },
        "workerVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "contracts.schema.json#/definitions/ModelCapabilities"
          }
        },
        "runtimeCheck": {
          "$ref": "#/definitions/RuntimeCheck"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "workerVersion",
        "models"
      ],
      "additionalProperties": false
    },
    "Progress": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "progress"
        },
        "event": {
          "$ref": "contracts.schema.json#/definitions/ProgressEvent"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "event"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "result"
        },
        "result": {
          "$ref": "contracts.schema.json#/definitions/EditResult"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "result"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "kind": {
              "enum": [
                "invalid",
                "unavailable",
                "cancelled",
                "internal"
              ]
            },
            "effect": {
              "enum": [
                "none",
                "unknown"
              ]
            },
            "details": {
              "type": "object",
              "properties": {
                "diagnostic": {
                  "$ref": "#/definitions/Diagnostic"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "kind",
            "effect",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "error"
      ],
      "additionalProperties": false
    },
    "CancelAck": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "cancelAck"
        },
        "targetId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "targetId",
        "accepted"
      ],
      "additionalProperties": false
    },
    "ShutdownAck": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "shutdownAck"
        }
      },
      "required": [
        "version",
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "Request": {
      "oneOf": [
        {
          "$ref": "#/definitions/Hello"
        },
        {
          "$ref": "#/definitions/Edit"
        },
        {
          "$ref": "#/definitions/Cancel"
        },
        {
          "$ref": "#/definitions/Shutdown"
        },
        {
          "$ref": "#/definitions/Generate"
        }
      ]
    },
    "Response": {
      "oneOf": [
        {
          "$ref": "#/definitions/Ready"
        },
        {
          "$ref": "#/definitions/Progress"
        },
        {
          "$ref": "#/definitions/Result"
        },
        {
          "$ref": "#/definitions/Error"
        },
        {
          "$ref": "#/definitions/CancelAck"
        },
        {
          "$ref": "#/definitions/ShutdownAck"
        }
      ]
    },
    "RuntimeCheck": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "imports-ready",
            "load-ready",
            "missing-package",
            "unsupported-version",
            "import-failed",
            "load-failed"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": [
            "loading",
            "editing",
            "saving",
            "worker",
            "generating"
          ]
        },
        "causes": {
          "type": "array",
          "maxItems": 4,
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "BackendUnavailable",
                  "ModuleNotFoundError",
                  "FileNotFoundError",
                  "PermissionError",
                  "MemoryError",
                  "ValueError",
                  "OSError",
                  "RuntimeError",
                  "Exception",
                  "ProcessExit"
                ]
              },
              "errno": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "reason": {
          "enum": [
            "missing-package",
            "unsupported-version",
            "missing-directory"
          ]
        }
      },
      "required": [
        "phase",
        "causes"
      ],
      "additionalProperties": false
    },
    "Generate": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "generate"
        },
        "request": {
          "$ref": "contracts.schema.json#/definitions/GenerateRequest"
        }
      },
      "required": [
        "version",
        "id",
        "type",
        "request"
      ],
      "additionalProperties": false
    }
  }
}
