{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EditRequestContract",
  "$ref": "#/definitions/EditRequest",
  "definitions": {
    "ReferenceGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "enum": [
            "subject",
            "object",
            "style",
            "background"
          ]
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "conditioning": {
          "enum": [
            "prompt",
            "identity",
            "appearance"
          ],
          "description": "Omitted means prompt grouping; dedicated conditioning requires a compatible prepared selection."
        },
        "className": {
          "enum": [
            "man",
            "woman",
            "girl",
            "boy"
          ],
          "description": "PhotoMaker identity class replacing the instruction placeholder {group-id}."
        }
      },
      "required": [
        "id",
        "role",
        "images"
      ],
      "additionalProperties": false
    },
    "ImageSize": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "EditRequest": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceImage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ReferenceGroup"
          }
        },
        "maskImage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "outputPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size": {
          "$ref": "#/definitions/ImageSize"
        },
        "parameters": {
          "$ref": "#/definitions/SamplingParameters"
        },
        "sidecar": {
          "$ref": "#/definitions/SidecarOptions"
        },
        "outpaint": {
          "$ref": "#/definitions/OutpaintCanvas"
        }
      },
      "required": [
        "model",
        "instruction",
        "outputPath"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "sourceImage"
          ]
        },
        {
          "required": [
            "references"
          ]
        }
      ],
      "dependencies": {
        "maskImage": [
          "sourceImage"
        ],
        "outpaint": [
          "sourceImage"
        ]
      }
    },
    "ModelCapabilities": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "instructionEditing": {
          "type": "boolean"
        },
        "referenceRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "subject",
              "object",
              "style",
              "background"
            ]
          }
        },
        "maxReferenceImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Limit on grouped reference images, excluding the source. Absence means no declared limit, not unlimited hardware capacity."
        },
        "maskMode": {
          "enum": [
            "none",
            "native",
            "composite",
            "latent-composite"
          ],
          "description": "none: unsupported; native: trained mask conditioning; composite: output-only blending; latent-composite: source latent blending plus final pixel compositing."
        },
        "size": {
          "type": "object",
          "properties": {
            "widthMultiple": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "heightMultiple": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "widthMultiple",
            "heightMultiple"
          ],
          "additionalProperties": false
        },
        "sourceImageRequired": {
          "type": "boolean",
          "description": "Whether this adapter requires a source image in addition to any references. Absence means unspecified."
        },
        "referenceConditioning": {
          "enum": [
            "ordered-images-with-role-prompt",
            "pooled-identity",
            "appearance-embedding"
          ]
        },
        "defaultOutputSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "inputGeometry": {
          "const": "klein-reference",
          "description": "Aspect-preserving downscale to 1024 squared pixels, then center crop to multiples of 16. Applies to source and references."
        },
        "textToImage": {
          "type": "boolean",
          "description": "Explicit text-only generation support. Absence means unsupported."
        },
        "maskRequired": {
          "type": "boolean",
          "description": "Whether every edit requires a mask as well as its source image."
        },
        "maxConditioningImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Limit on all conditioning images together: source plus grouped references. Masks are excluded."
        },
        "parameters": {
          "$ref": "#/definitions/ParameterCapabilities"
        },
        "outpainting": {
          "type": "boolean",
          "description": "SDK canvas expansion through this model mask workflow; preservation follows maskMode."
        },
        "loraFormats": {
          "type": "array",
          "items": {
            "enum": [
              "sd-unet-safetensors"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "model",
        "instructionEditing",
        "referenceRoles",
        "maskMode"
      ],
      "additionalProperties": false
    },
    "ImageArtifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "mimeType": {
          "const": "image/png"
        },
        "size": {
          "$ref": "#/definitions/ImageSize"
        }
      },
      "required": [
        "path",
        "mimeType",
        "size"
      ],
      "additionalProperties": false
    },
    "EditResult": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/ImageArtifact"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "modelRevision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReferenceGroup"
          }
        },
        "cleanupWarning": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "directory",
            "message"
          ],
          "additionalProperties": false
        },
        "inputGeometry": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InputGeometry"
          }
        },
        "effectiveParameters": {
          "$ref": "#/definitions/SamplingParameters"
        },
        "sidecar": {
          "$ref": "#/definitions/SidecarOutcome"
        },
        "outpaint": {
          "$ref": "#/definitions/OutpaintGeometry"
        },
        "conditioning": {
          "$ref": "#/definitions/ConditioningProvenance"
        },
        "loras": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LoraProvenance"
          }
        }
      },
      "required": [
        "image",
        "model",
        "modelRevision",
        "runtime",
        "seed",
        "references",
        "effectiveParameters"
      ],
      "additionalProperties": false
    },
    "ProgressEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress"
        },
        "verb": {
          "enum": [
            "edit",
            "generate"
          ]
        },
        "stage": {
          "enum": [
            "preparing",
            "loading",
            "editing",
            "saving",
            "generating"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "verb",
        "stage",
        "message"
      ],
      "additionalProperties": false
    },
    "ModelComponent": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "weights",
            "configuration",
            "tokenizer",
            "shard-index",
            "asset"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "role",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "ModelManifest": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            }
          },
          "required": [
            "repository",
            "revision"
          ],
          "additionalProperties": false
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ModelComponent"
          }
        }
      },
      "required": [
        "version",
        "model",
        "source",
        "components"
      ],
      "additionalProperties": false
    },
    "LocalEditingModel": {
      "type": "object",
      "properties": {
        "variant": {
          "enum": [
            "flux2-klein-4b",
            "flux2-klein-9b",
            "flux2-klein-base-4b",
            "flux2-klein-base-9b",
            "z-image-turbo",
            "flux1-schnell",
            "flux1-dev",
            "flux1-krea-dev",
            "flux1-fill-dev",
            "flux1-kontext-dev",
            "z-image",
            "ernie-image",
            "ernie-image-turbo",
            "qwen-image",
            "qwen-image-edit-2511",
            "qwen-image-2.1",
            "sd15",
            "sdxl",
            "sd15-inpaint",
            "sdxl-inpaint",
            "sdxl-photomaker-v1",
            "sd15-ip-adapter",
            "sdxl-ip-adapter",
            "sd15-ip-adapter-plus",
            "sdxl-ip-adapter-plus"
          ]
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/definitions/ModelManifest"
        },
        "quantize": {
          "enum": [
            4,
            8
          ]
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "description": "Native checkpoint path relative to the prepared model directory."
        },
        "vae": {
          "type": "string",
          "minLength": 1,
          "description": "Optional native VAE path relative to the prepared model directory."
        },
        "photoMaker": {
          "type": "string",
          "minLength": 1,
          "description": "Prepared native auxiliary weight path relative to the model directory."
        },
        "ipAdapter": {
          "type": "string",
          "minLength": 1,
          "description": "Prepared native auxiliary weight path relative to the model directory."
        },
        "clipVision": {
          "type": "string",
          "minLength": 1,
          "description": "Prepared native auxiliary weight path relative to the model directory."
        },
        "loras": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/LocalLora"
          }
        }
      },
      "required": [
        "variant",
        "directory",
        "manifest"
      ],
      "additionalProperties": false
    },
    "InputGeometry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "originalSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "orientedSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "scaledSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "preparedSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "crop": {
          "type": "object",
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0
            },
            "top": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "left",
            "top"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "path",
        "originalSize",
        "orientedSize",
        "scaledSize",
        "preparedSize",
        "crop"
      ],
      "additionalProperties": false
    },
    "GenerateRequest": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outputPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size": {
          "$ref": "#/definitions/ImageSize"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "parameters": {
          "$ref": "#/definitions/SamplingParameters"
        },
        "sidecar": {
          "$ref": "#/definitions/SidecarOptions"
        }
      },
      "required": [
        "model",
        "prompt",
        "outputPath"
      ],
      "additionalProperties": false
    },
    "SamplingParameters": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "guidance": {
          "type": "number",
          "minimum": 0
        },
        "negativePrompt": {
          "type": "string"
        },
        "scheduler": {
          "type": "string",
          "minLength": 1
        },
        "sampler": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "description": "Edit-only denoising strength. Lower values retain more source influence; zero still encodes/decodes and is not a pixel-preserving no-op. Unsupported for generation.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "identityStyleStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Edit-only conditioning control for the corresponding advertised method."
        },
        "appearanceStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.4028234663852886e+38,
          "description": "Edit-only conditioning control for the corresponding advertised method."
        }
      },
      "additionalProperties": false
    },
    "ParameterCapabilities": {
      "type": "object",
      "description": "Absent controls are unsupported. Descriptors apply to every advertised operation of this model.",
      "properties": {
        "steps": {
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "integer": {
              "type": "boolean"
            }
          },
          "required": [
            "default",
            "minimum"
          ],
          "additionalProperties": false
        },
        "guidance": {
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "integer": {
              "type": "boolean"
            }
          },
          "required": [
            "default",
            "minimum"
          ],
          "additionalProperties": false
        },
        "scheduler": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "default",
            "values"
          ],
          "additionalProperties": false
        },
        "negativePrompt": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            },
            "requiresGuidanceAbove": {
              "type": "number"
            },
            "requiredForGuidanceAbove": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "sampler": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "default",
            "values"
          ],
          "additionalProperties": false
        },
        "strength": {
          "description": "Denoising strength for edit operations only; never a generation default. Semantics and bounds are model-specific.",
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "integer": {
              "type": "boolean"
            },
            "minimumExclusive": {
              "type": "boolean",
              "description": "When true, the minimum itself is not supported."
            }
          },
          "required": [
            "default",
            "minimum"
          ],
          "additionalProperties": false
        },
        "identityStyleStrength": {
          "description": "Edit-only conditioning control; unsupported unless advertised.",
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "integer": {
              "type": "boolean"
            }
          },
          "required": [
            "default",
            "minimum"
          ],
          "additionalProperties": false
        },
        "appearanceStrength": {
          "description": "Edit-only conditioning control; unsupported unless advertised.",
          "type": "object",
          "properties": {
            "default": {
              "type": "number"
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "integer": {
              "type": "boolean"
            }
          },
          "required": [
            "default",
            "minimum"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "SidecarOptions": {
      "type": "object",
      "properties": {
        "includeInputs": {
          "type": "boolean",
          "description": "Explicitly retain prompt/instruction, negative prompt and path-free input descriptions. False by default."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SidecarOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "saved"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "failed"
            },
            "path": {
              "type": "string"
            },
            "code": {
              "enum": [
                "OUTPUT_CONFLICT",
                "OUTPUT_IO"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "path",
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ArtifactRecord": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "operation": {
          "enum": [
            "edit",
            "generate"
          ]
        },
        "inputsIncluded": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "mimeType": {
              "const": "image/png"
            },
            "size": {
              "$ref": "#/definitions/ImageSize"
            },
            "filename": {
              "type": "string",
              "minLength": 1,
              "description": "Filename only, without directory information."
            }
          },
          "required": [
            "mimeType",
            "size",
            "filename"
          ],
          "additionalProperties": false
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "modelRevision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "effectiveParameters": {
          "$ref": "#/definitions/SamplingParameters"
        },
        "inputs": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string"
            },
