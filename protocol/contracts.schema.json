{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EditRequestContract",
  "$ref": "#/definitions/EditRequest",
  "definitions": {
    "ReferenceGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "role": {
          "enum": [
            "subject",
            "object",
            "style",
            "background"
          ]
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          }
        }
      },
      "required": [
        "id",
        "role",
        "images"
      ],
      "additionalProperties": false
    },
    "ImageSize": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "EditRequest": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sourceImage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ReferenceGroup"
          }
        },
        "maskImage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "outputPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size": {
          "$ref": "#/definitions/ImageSize"
        }
      },
      "required": [
        "model",
        "instruction",
        "outputPath"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "sourceImage"
          ]
        },
        {
          "required": [
            "references"
          ]
        }
      ],
      "dependencies": {
        "maskImage": [
          "sourceImage"
        ]
      }
    },
    "ModelCapabilities": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "instructionEditing": {
          "type": "boolean"
        },
        "referenceRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "subject",
              "object",
              "style",
              "background"
            ]
          }
        },
        "maxReferenceImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Limit on grouped reference images, excluding the source. Absence means no declared limit, not unlimited hardware capacity."
        },
        "maskMode": {
          "enum": [
            "none",
            "native",
            "composite"
          ]
        },
        "size": {
          "type": "object",
          "properties": {
            "widthMultiple": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "heightMultiple": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "widthMultiple",
            "heightMultiple"
          ],
          "additionalProperties": false
        },
        "sourceImageRequired": {
          "type": "boolean",
          "description": "Whether this adapter requires a source image in addition to any references. Absence means unspecified."
        },
        "referenceConditioning": {
          "const": "ordered-images-with-role-prompt",
          "description": "Source first, then groups and images in caller order. Group IDs and roles are prompt labels, not separate model controls or identity guarantees."
        },
        "defaultOutputSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "inputGeometry": {
          "const": "klein-reference",
          "description": "Aspect-preserving downscale to 1024 squared pixels, then center crop to multiples of 16. Applies to source and references."
        },
        "textToImage": {
          "type": "boolean",
          "description": "Explicit text-only generation support. Absence means unsupported."
        },
        "maskRequired": {
          "type": "boolean",
          "description": "Whether every edit requires a mask as well as its source image."
        },
        "maxConditioningImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Limit on all conditioning images together: source plus grouped references. Masks are excluded."
        }
      },
      "required": [
        "model",
        "instructionEditing",
        "referenceRoles",
        "maskMode"
      ],
      "additionalProperties": false
    },
    "ImageArtifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "mimeType": {
          "const": "image/png"
        },
        "size": {
          "$ref": "#/definitions/ImageSize"
        }
      },
      "required": [
        "path",
        "mimeType",
        "size"
      ],
      "additionalProperties": false
    },
    "EditResult": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/ImageArtifact"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "modelRevision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReferenceGroup"
          }
        },
        "cleanupWarning": {
          "type": "object",
          "properties": {
            "directory": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "directory",
            "message"
          ],
          "additionalProperties": false
        },
        "inputGeometry": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InputGeometry"
          }
        }
      },
      "required": [
        "image",
        "model",
        "modelRevision",
        "runtime",
        "seed",
        "references"
      ],
      "additionalProperties": false
    },
    "ProgressEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "progress"
        },
        "verb": {
          "enum": [
            "edit",
            "generate"
          ]
        },
        "stage": {
          "enum": [
            "preparing",
            "loading",
            "editing",
            "saving",
            "generating"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "verb",
        "stage",
        "message"
      ],
      "additionalProperties": false
    },
    "ModelComponent": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "weights",
            "configuration",
            "tokenizer",
            "shard-index",
            "asset"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "role",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "ModelManifest": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "model": {
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "\\S"
            },
            "revision": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            }
          },
          "required": [
            "repository",
            "revision"
          ],
          "additionalProperties": false
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/ModelComponent"
          }
        }
      },
      "required": [
        "version",
        "model",
        "source",
        "components"
      ],
      "additionalProperties": false
    },
    "LocalEditingModel": {
      "type": "object",
      "properties": {
        "variant": {
          "enum": [
            "flux2-klein-4b",
            "flux2-klein-9b",
            "flux2-klein-base-4b",
            "flux2-klein-base-9b",
            "z-image-turbo",
            "flux1-schnell",
            "flux1-dev",
            "flux1-krea-dev",
            "flux1-fill-dev",
            "flux1-kontext-dev",
            "z-image",
            "ernie-image",
            "ernie-image-turbo",
            "qwen-image",
            "qwen-image-edit-2511",
            "qwen-image-2.1"
          ]
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/definitions/ModelManifest"
        },
        "quantize": {
          "enum": [
            4,
            8
          ]
        }
      },
      "required": [
        "variant",
        "directory",
        "manifest"
      ],
      "additionalProperties": false
    },
    "InputGeometry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "originalSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "orientedSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "scaledSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "preparedSize": {
          "$ref": "#/definitions/ImageSize"
        },
        "crop": {
          "type": "object",
          "properties": {
            "left": {
              "type": "integer",
              "minimum": 0
            },
            "top": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "left",
            "top"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "path",
        "originalSize",
        "orientedSize",
        "scaledSize",
        "preparedSize",
        "crop"
      ],
      "additionalProperties": false
    },
    "GenerateRequest": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outputPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "size": {
          "$ref": "#/definitions/ImageSize"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "model",
        "prompt",
        "outputPath"
      ],
      "additionalProperties": false
    }
  }
}
