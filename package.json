{
  "name": "picpatch",
  "productName": "PicPatch",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.2.0",
  "description": "Generate and edit images with local AI models.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/picpatch.git"
  },
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "sdk"
  ],
  "engines": {
    "node": ">=24"
  },
  "config": {
    "devPort": 23297
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck:app && electron-vite build",
    "dist": "npm run build && npm run prepare:tools && npm run prepare:electron && electron-builder --publish never",
    "prepare:electron": "node node_modules/electron/install.js",
    "prepare:tools": "node scripts/prepare-tools.mjs",
    "typecheck": "npm run typecheck:app && tsc -p tsconfig.test.json && npm run typecheck --workspace picpatchsdk",
    "typecheck:app": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "npm run typecheck && vitest run && npm run test --workspace picpatchsdk",
    "test:node": "npm run typecheck && vitest run && npm run test:node --workspace picpatchsdk",
    "test:full": "npm run typecheck && vitest run && npm run test:full --workspace picpatchsdk && vitest run --config vitest.live.config.ts",
    "test:coverage": "npm run typecheck && vitest run --coverage && npm run test:coverage --workspace picpatchsdk",
    "test:watch": "vitest",
    "check:release-tag": "node scripts/check-release-tag.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "sharp": "^0.35.5",
    "stream-json": "^3.7.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.2",
    "picpatchsdk": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false
  }
}
