{
  "name": "picpatchsdk",
  "version": "0.0.0",
  "private": true,
  "description": "PicPatchSdk: local image generation and editing.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Yoshinao Inoguchi",
    "email": "yoshinao@inoguchi.com",
    "url": "https://github.com/nao7sep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nao7sep/picpatch.git",
    "directory": "sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/browser-types.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "protocol/*.json",
    "runtimes/*/pyproject.toml",
    "runtimes/*/uv.lock",
    "runtimes/*/engine_probe.py",
    "runtimes/*/src/**/*.py",
    "runtimes/*/src/**/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.types.json && tsc -p tsconfig.test.json",
    "test": "npm run test:node && npm run test:python",
    "test:node": "npm run contracts:check && npm run typecheck && vitest run",
    "test:coverage": "npm run contracts:check && npm run typecheck && vitest run --coverage",
    "example:request": "node examples/edit-request.ts",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "test:python": "node scripts/python-tests.ts",
    "test:python:coverage": "node scripts/python-tests.ts --cov=picpatch_worker --cov-report=term-missing --cov-config=runtimes/mflux/pyproject.toml --cov-report=html:coverage/python",
    "test:full": "npm test && vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "sharp": "^0.35.5",
    "stream-json": "^3.7.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
